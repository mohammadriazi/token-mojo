<UserControl x:Class="TokenMojo.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TokenMojo"
             Width="340"
             TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
             TextElement.FontSize="13">
    <UserControl.Resources>
        <local:VisibleWhenConverter x:Key="VisibleWhen" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="Digits" TargetType="TextBlock">
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel x:Name="Panel">
            <!-- Header: model, session name, working directory -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,10,0" VerticalAlignment="Top">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF9500" Offset="0" />
                            <GradientStop Color="#FF2D55" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#x2726;" Foreground="White" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModelName}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SessionName}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding SessionName, Converter={StaticResource VisibleWhen}}" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding Directory, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding Directory}" ToolTip="{Binding Directory}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="260" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 5-hour and 7-day rings; absent for API-key users -->
            <ItemsControl ItemsSource="{Binding Limits}" Visibility="{Binding Limits, Converter={StaticResource VisibleWhen}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,12" Padding="0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <Grid Width="76" Height="76" Margin="0,0,0,6">
                                    <local:RingGauge Percent="{Binding RingPercent}" Severity="{Binding Severity}"
                                                     TrackBrush="{DynamicResource TrackBrush}" />
                                    <TextBlock Text="{Binding PercentText}" Style="{StaticResource Digits}" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ResetText}" Style="{StaticResource Secondary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Context window -->
            <Border Style="{StaticResource Card}" Visibility="{Binding Context, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Context.Text}" Style="{StaticResource Digits}" FontSize="12" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" />
                            <TextBlock Text="Context window" Style="{StaticResource Heading}" FontSize="12" />
                        </StackPanel>
                    </DockPanel>
                    <local:CapsuleBar Height="8" Percent="{Binding Context.BarPercent}" Severity="{Binding Context.Severity}"
                                      TrackBrush="{DynamicResource TrackBrush}" />
                </StackPanel>
            </Border>

            <!-- Stat tiles -->
            <UniformGrid Columns="2" Margin="0,0,-10,0">
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,10,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C7;" FontSize="18" Foreground="#34C759" Margin="0,0,8,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding CostText}" Style="{StaticResource Digits}" FontWeight="SemiBold" />
                            <TextBlock Text="Session cost" Style="{StaticResource Secondary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,10,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="18" Foreground="#FF9500" Margin="0,0,8,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding LinesText}" Style="{StaticResource Digits}" FontWeight="SemiBold" />
                            <TextBlock Text="Lines changed" Style="{StaticResource Secondary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,10,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="18" Foreground="#0A84FF" Margin="0,0,8,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding InputTokensText}" Style="{StaticResource Digits}" FontWeight="SemiBold" />
                            <TextBlock Text="Input tokens" Style="{StaticResource Secondary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,10,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE898;" FontSize="18" Foreground="#AF52DE" Margin="0,0,8,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding OutputTokensText}" Style="{StaticResource Digits}" FontWeight="SemiBold" />
                            <TextBlock Text="Output tokens" Style="{StaticResource Secondary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Sessions from the last 12 hours -->
            <Border Style="{StaticResource Card}" Visibility="{Binding Sessions, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Sessions.Summary}" Style="{StaticResource Secondary}"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" />
                            <TextBlock Text="Sessions · last 12h" Style="{StaticResource Heading}" FontSize="12" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Sessions.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="8,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CurrentRowBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource IdleDotBrush}" />
                                                    <Setter Property="ToolTip" Value="Idle" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                                            <Setter Property="ToolTip" Value="Active in the last 10 minutes" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CostText}" Style="{StaticResource Digits}" FontWeight="SemiBold" FontSize="12"
                                                       HorizontalAlignment="Right" Margin="0,0,0,4" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <local:CapsuleBar Width="36" Height="5" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                  Percent="{Binding ContextBarPercent}" Severity="{Binding ContextSeverity}"
                                                                  TrackBrush="{DynamicResource TrackBrush}" />
                                                <TextBlock Text="{Binding ContextText}" Style="{StaticResource Digits}" FontSize="10" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE823;" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Secondary}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
