<Window x:Class="TokenMojo.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TokenMojo"
        Title="TokenMojo"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" Padding="10,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel>
        <local:DashboardView x:Name="Dashboard" />
        <Border Height="1" Background="{DynamicResource WindowBorderBrush}" />
        <!-- The Mac dropdown's menu items -->
        <StackPanel Margin="6">
            <Button Style="{StaticResource MenuButton}" Content="Pop Out Window" Click="OnPopOut" />
            <Button Style="{StaticResource MenuButton}" Click="OnToggleLaunchAtLogin">
                <DockPanel>
                    <TextBlock x:Name="LaunchAtLoginCheck" DockPanel.Dock="Right" FontFamily="{DynamicResource IconFont}"
                               Text="&#xE73E;" VerticalAlignment="Center" />
                    <TextBlock Text="Launch at Login" Width="290" />
                </DockPanel>
            </Button>
            <Button Style="{StaticResource MenuButton}" Content="Quit" Click="OnQuit" />
        </StackPanel>
    </StackPanel>
</Window>
